# ==============================================================
# SRE AI Observer - Configuration Template
# ==============================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Choose your AI provider: 'groq' | 'gemini' | 'openrouter' | 'ollama'
AI_PROVIDER=groq

# API Key for your chosen provider:
AI_API_KEY=gsk_your_groq_api_key_here

# --------------------------------------------------------------
# Supported Providers & Presets:
#
# 1) Groq Cloud (Recommended - sub-second latency, generous free tier):
#    Get key at: https://console.groq.com/keys
#    AI_PROVIDER=groq
#    AI_API_KEY=gsk_your_groq_key_here
#    # Default model: llama-3.3-70b-versatile
#
# 2) Google AI Studio (Free tier 1,500 req/day):
#    Get key at: https://aistudio.google.com/
#    AI_PROVIDER=gemini
#    AI_API_KEY=AIzaSy_your_gemini_key_here
#    # Default model: gemini-2.0-flash
#
# 3) OpenRouter (Multi-model aggregator):
#    Get key at: https://openrouter.ai/keys
#    AI_PROVIDER=openrouter
#    AI_API_KEY=sk-or-v1-your_openrouter_key_here
#    # Default model: meta-llama/llama-3.3-70b-instruct:free
#
# 4) Ollama (Local offline inference, completely private):
#    Install Ollama (https://ollama.com) and pull: ollama pull qwen2.5:7b
#    AI_PROVIDER=ollama
#    AI_API_KEY=ollama
# --------------------------------------------------------------

# Optional Overrides (Leave commented out to use provider defaults):
# AI_MODEL=
# AI_BASE_URL=
